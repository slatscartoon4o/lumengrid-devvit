{
  "private": true,
  "name": "lumengrid",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "LumenGrid — a daily optical laser-prism puzzle game for Reddit (Devvit Web interactive post).",
  "scripts": {
    "build": "vite build",
    "build:preview": "vite build --mode preview && node scripts/build-local.mjs",
    "dev": "devvit playtest",
    "login": "devvit login",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --build",
    "test:unit": "vitest run",
    "preview": "node dist-local/server/local-server.cjs",
    "showcase": "node scripts/capture-showcase.mjs",
    "probe:leaderboard": "node scripts/probe-leaderboard.mjs",
    "probe:splash": "node scripts/probe-splash-fit.mjs",
    "check:dead": "node scripts/check-dead-exports.mjs",
    "check": "npm run test:types && npm run lint && npm run check:dead",
    "lint": "eslint src",
    "deploy": "npm run test:types && devvit upload"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.6",
    "@devvit/web": "0.15.6",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.6",
    "hono": "4.13.21",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "playwright": "^1.65.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
